        "generate hashtags from text",
        "hashtag suggestion",
        "text to hashtag",
        "social media hashtags"
    ],
    "homepage": "https://apiverve.com/marketplace/hashtaggenerator?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
